  match_method      String        @db.VarChar(32) // "phone_exact" | "email_exact" | "name_last4_phone" | "no_match"
  confidence        Float
  status            String        @db.VarChar(16) // "matched" | "ambiguous" | "no_match" | "rejected"
  candidates        Json?         @default("[]")
  reviewed_at       DateTime?     @db.Timestamptz(6)
  reviewed_by       String?       @db.VarChar(64)
