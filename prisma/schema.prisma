  @@index([tenant_id, attempted_at(sort: Desc)], map: "idx_lead_match_tenant")
  @@index([facility_id, status], map: "idx_lead_match_facility_status")
  @@index([status, attempted_at(sort: Desc)], map: "idx_lead_match_status")
}

// Roadmap 10 phase 1 (revised): append-only status history for partial_leads.
// partial_leads only carries current lead_status; this table preserves every
// transition so the attribution chain can answer "when did this lead become a
// qualified inquiry / tour_booked / moved_in?"
model lead_status_events {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partial_lead_id  String        @db.Uuid
  from_status      String?       @db.VarChar(32)
  to_status        String        @db.VarChar(32)
  changed_at       DateTime      @default(now()) @db.Timestamptz(6)
  changed_by       String?       @db.VarChar(64) // admin email, "system", "cron:<name>", etc.
  source           String?       @db.VarChar(32) // "phone_call" | "chat" | "form" | "pms_import" | "manual"
  source_ref_id    String?       @db.Uuid        // pointer into call_logs / tenants / etc. depending on source
  notes            String?

  partial_leads    partial_leads @relation(fields: [partial_lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([partial_lead_id, changed_at(sort: Desc)], map: "idx_lead_status_events_lead")
  @@index([to_status, changed_at(sort: Desc)], map: "idx_lead_status_events_status")
}

// Roadmap 08 phase 2: weekly snapshot of price-sensitivity features per active
// tenant. Feeds the ECRI cycle recommendation engine (Phase 3) without
// duplicating tenant data — joins to tenants on tenant_id.
model tenant_sensitivity_features {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                   String   @db.Uuid
  facility_id                 String   @db.Uuid
  snapshot_date               DateTime @db.Date

  tenure_months               Int
  months_since_last_increase  Int?

  payment_health_score        Float    // 0..1, 1 = perfect history
  late_payment_count_12mo     Int      @default(0)
  autopay_flag                Boolean  @default(false)

  current_rate                Decimal? @db.Decimal(10, 2)
  market_rate                 Decimal? @db.Decimal(10, 2)
  rate_gap_pct                Float?   // (market - current) / market, positive = under-priced

  unit_size                   String?
  has_insurance               Boolean  @default(false)

  sensitivity_score           Float    // 0..1, 1 = highly price-sensitive
  bucket                      String   @db.VarChar(16) // "very_low" | "low" | "medium" | "high"
  factors                     Json?    @default("{}")

  computed_at                 DateTime @default(now()) @db.Timestamptz(6)

  tenants                     tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, snapshot_date])
  @@index([tenant_id, snapshot_date(sort: Desc)], map: "idx_tenant_sensitivity_tenant")
  @@index([facility_id, bucket], map: "idx_tenant_sensitivity_facility_bucket")
}

// Roadmap 13 phase 1: composes weekly/monthly NOI lift snapshots per facility
// from the existing PMS, marketing, ECRI, and retention tables. The snapshot
// is a cache/rollup, not a source of truth.
model noi_report_snapshots {
  id                            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility_id                   String     @db.Uuid
  report_period                 String     @db.VarChar(16) // "weekly" | "monthly"
  period_start                  DateTime   @db.Date
  period_end                    DateTime   @db.Date

  total_revenue                 Decimal?   @default(0) @db.Decimal(12, 2)
  rent_revenue                  Decimal?   @default(0) @db.Decimal(12, 2)
  fee_revenue                   Decimal?   @default(0) @db.Decimal(12, 2)
  auction_revenue               Decimal?   @default(0) @db.Decimal(12, 2)

  new_move_ins                  Int?       @default(0)
  move_outs                     Int?       @default(0)
  net_units                     Int?       @default(0)

  dynamic_pricing_lift          Decimal?   @default(0) @db.Decimal(12, 2)
  ecri_realized_lift            Decimal?   @default(0) @db.Decimal(12, 2)
  retention_saves               Int?       @default(0)
  retention_saves_value         Decimal?   @default(0) @db.Decimal(12, 2)

  marketing_spend               Decimal?   @default(0) @db.Decimal(10, 2)
  leads_generated               Int?       @default(0)
  attributed_move_ins           Int?       @default(0)
  attributed_revenue            Decimal?   @default(0) @db.Decimal(12, 2)

  vs_prior_period_revenue_delta Decimal?   @default(0) @db.Decimal(12, 2)
  vs_year_ago_revenue_delta     Decimal?   @default(0) @db.Decimal(12, 2)

  estimated_noi_lift            Decimal?   @default(0) @db.Decimal(12, 2)
  platform_fee                  Decimal?   @default(0) @db.Decimal(10, 2)
  net_value_delivered           Decimal?   @default(0) @db.Decimal(12, 2)

  pending_approvals             Json?      @default("[]")
  source_notes                  Json?      @default("{}") // tracks which feeds were available at compute time

  computed_at                   DateTime   @default(now()) @db.Timestamptz(6)

  facilities                    facilities @relation(fields: [facility_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([facility_id, report_period, period_start])
  @@index([facility_id, computed_at(sort: Desc)], map: "idx_noi_snapshots_facility")
  @@index([report_period, period_start(sort: Desc)], map: "idx_noi_snapshots_period")
}

