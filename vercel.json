{
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/cleanup-sessions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/send-client-reports",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/aggregate-page-stats",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sync-audiences",
      "schedule": "0 1 * * 0"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 5"
    },
    {
      "path": "/api/cron/review-solicitation",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/process-gbp",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/process-drips",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/process-nurture",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/process-recovery",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/check-campaign-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cleanup-organizations",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/score-churn-risk",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/cron/score-ecri-sensitivity",
      "schedule": "0 11 * * 2"
    },
    {
      "path": "/api/cron/update-retention-outcomes",
      "schedule": "30 11 * * 1"
    },
    {
      "path": "/api/cron/generate-noi-reports",
      "schedule": "0 12 * * 5"
    },
    {
      "path": "/api/cron/weekly-synthesis",
      "schedule": "0 10 * * 0"
    },
    {
      "path": "/api/cron/process-synthesis-queue",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/photo-refresh-prompts",
      "schedule": "0 13 1 * *"
    },
    {
      "path": "/api/cron/generate-rev-share-payouts",
      "schedule": "0 8 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)\\.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
