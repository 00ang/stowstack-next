/// Durable work queue (MISSION.md s1).
///
/// Exists because every long job in this repo runs inside a Vercel function
/// capped at 300s: a portfolio mail drop, a 20-facility PMS sync or a review
/// sweep across 12,000 units cannot finish in one invocation, and today they
/// simply die mid-run. A job here carries its own `cursor`, so the worker can
/// stop at the time budget, persist where it got to, and the next invocation
/// resumes instead of restarting.
///
/// `status` is one of: pending | running | done | failed | frozen.
/// `frozen` is deliberate and is NOT retried — it means the outcome is UNKNOWN
/// (a vendor timeout after the request may have landed). Retrying an unknown
/// send is how you mail a card twice and pay for it twice.
model jobs {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queue            String    @db.VarChar(64)
  payload          Json      @default("{}")
  status           String    @default("pending") @db.VarChar(16)
  /// Fair-share key (MISSION.md s2). One tenant must not be able to starve
  /// another on a shared vendor limit, so the claim orders by in-flight work
  /// per tenant rather than first-come-first-served.
  tenant_key       String?   @db.VarChar(128)
  /// Idempotency. NULL is allowed and repeats freely; a set value is unique
  /// per queue, so enqueueing the same unit of work twice is a no-op.
  dedupe_key       String?   @db.VarChar(200)
  cursor           Json?
  progress_done    Int       @default(0)
  progress_total   Int?
  attempts         Int       @default(0)
  max_attempts     Int       @default(5)
  run_after        DateTime  @default(now()) @db.Timestamptz(6)
  locked_by        String?   @db.VarChar(64)
  lease_expires_at DateTime? @db.Timestamptz(6)
  last_error       String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @default(now()) @db.Timestamptz(6)
  finished_at      DateTime? @db.Timestamptz(6)

  @@unique([queue, dedupe_key], map: "jobs_queue_dedupe_key")
  @@index([status, run_after], map: "idx_jobs_claim")
  @@index([queue, status], map: "idx_jobs_queue_status")
  @@index([tenant_key, status], map: "idx_jobs_tenant")
  @@index([lease_expires_at], map: "idx_jobs_lease")
}

/// Domain event log / outbox (MISSION.md s7).
///
/// Half of Modules v2 is "when X happens, do Y" — the welcome kit on move-in,
/// the referral card in month two, the rate-increase letter, the delinquency
/// ladder, the sold-out waitlist. None of it had an X. This is the X.
///
/// Append-only. An event is a fact that already happened; it is never edited or
/// deleted, only superseded by a later fact. Delivery is NOT tracked here —
/// each subscriber gets its own row in `jobs`, so retries, freezes and
/// fair-share come from the queue rather than being reinvented.
model domain_events {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String   @db.VarChar(64)
  facility_id String?  @db.Uuid
  /// Fair-share bucket handed to every job fanned out from this event.
  tenant_key  String?  @db.VarChar(128)
  payload     Json     @default("{}")
  /// Identity of the FACT, not of the detection run. A given account moving
  /// into a given unit happens once, so re-running detection over the same
  /// snapshots emits nothing new.
  source_key  String   @db.VarChar(300)
  occurred_at DateTime @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([type, source_key])
  @@index([facility_id, type, occurred_at], map: "idx_events_facility_type")
  @@index([occurred_at], map: "idx_events_occurred")
  @@index([type, created_at], map: "idx_events_type_created")
}

/// Unit-mix history (MISSION.md s7 follow-on).
///
/// `facility_pms_units` is upserted CURRENT state — it has `last_updated` and no
/// snapshot date — so there is no previous row to diff and the sold-out waitlist
/// trigger (RESPOND r9 / CONVERT c6) could not be produced. Twenty-five files
/// read that table and four write it, so adding a snapshot column there would
/// change semantics under all of them.
///
/// This is the additive alternative: the detection job copies the current mix in
/// here whenever the source data has moved, and diffs the last two captures.
/// Nothing that writes `facility_pms_units` today has to change.
///
/// `captured_at` is the facility's own latest unit-data timestamp, not the time
/// we looked — so a capture is atomic per facility and re-running detection
/// records nothing new.
model facility_pms_unit_history {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility_id    String   @db.Uuid
  captured_at    DateTime @db.Timestamptz(6)
  unit_type      String
  size_label     String?
  total_count    Int
  occupied_count Int
  vacant_count   Int?
  street_rate    Decimal? @db.Decimal(10, 2)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([facility_id, unit_type, captured_at], map: "pms_unit_history_key")
  @@index([facility_id, captured_at], map: "idx_unit_history_facility")
}

/// Sold-out waitlist (MISSION.md RESPOND r9 / CONVERT c6).
///
/// Someone wants a 10x10 and there isn't one. Capturing that is the difference
/// between a lost enquiry and a unit that sells itself the moment it frees up —
/// which the `inventory.available` event now makes possible.
model unit_waitlist {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility_id   String    @db.Uuid
  /// Matched against the size that frees up. Null means "any size here".
  size_label    String?
  contact_name  String?
  contact_phone String    @db.VarChar(20)
  contact_email String?
  /// waiting | notified | converted | cancelled
  status        String    @default("waiting") @db.VarChar(16)
  notified_at   DateTime? @db.Timestamptz(6)
  notify_count  Int       @default(0)
  source        String?   @db.VarChar(32)
  language      String    @default("en") @db.VarChar(5)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @default(now()) @db.Timestamptz(6)

  @@index([facility_id, size_label, status], map: "idx_waitlist_match")
  @@index([contact_phone], map: "idx_waitlist_phone")
}

/// Every outbound message, written BEFORE it is sent (MISSION.md s5).
///
/// The intent row is the idempotency guard, ported from the mail system: a
/// crash between "sent" and "recorded" must never let a retry text somebody
/// twice. `dedupe_key` is unique, so a replayed job is a no-op rather than a
/// second message to a real phone.
///
/// `frozen` means the outcome is UNKNOWN — the provider may or may not have
/// delivered — and is never retried automatically.
model message_log {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility_id String?   @db.Uuid
  /// sms | voice
  channel     String    @db.VarChar(8)
  direction   String    @default("outbound") @db.VarChar(8)
  to_number   String    @db.VarChar(20)
  from_number String?   @db.VarChar(20)
  body        String
  /// queued | sent | failed | frozen | suppressed
  status      String    @default("queued") @db.VarChar(16)
  provider    String?   @db.VarChar(16)
  provider_id String?
  dedupe_key  String    @db.VarChar(200)
  error       String?
  sent_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @default(now()) @db.Timestamptz(6)

  @@unique([dedupe_key], map: "message_log_dedupe_key")
  @@index([facility_id, created_at], map: "idx_message_facility")
  @@index([status], map: "idx_message_status")
  @@index([to_number], map: "idx_message_to")
}

/// One opt-out registry, forever, everywhere (MISSION.md s5).
///
/// A STOP reply is a legal obligation, not a preference: it outranks every
/// other rule and every campaign. Global by phone number rather than scoped to
/// a facility — somebody who said stop did not mean "stop, but only here".
model message_optout {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String   @unique @db.VarChar(20)
  reason     String?  @db.VarChar(32)
  source     String?  @db.VarChar(32)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

/// Unit reservation lock (MISSION.md s10).
///
/// Two callers must not be able to book the same unit. The PMS is the source of
/// truth for how many of a size exist and how many are occupied, but it is
/// updated by upload — minutes to hours behind — so it cannot arbitrate a race
/// happening on two phone calls right now. This table is that arbiter:
/// availability is the PMS vacancy minus the holds we ourselves are carrying.
///
/// Holds expire. A caller who says "let me think" must not silently keep a unit
/// off the market forever, so a hold is a short lease, not a booking.
model unit_hold {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility_id    String    @db.Uuid
  size_label     String?
  unit_type      String?
  held_for_phone String?   @db.VarChar(20)
  held_for_name  String?
  waitlist_id    String?   @db.Uuid
  /// waitlist | call | web
  source         String    @default("web") @db.VarChar(16)
  /// active | converted | released | expired
  status         String    @default("active") @db.VarChar(16)
  expires_at     DateTime  @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @default(now()) @db.Timestamptz(6)

  @@index([facility_id, size_label, status, expires_at], map: "idx_hold_availability")
  @@index([held_for_phone], map: "idx_hold_phone")
}

/// Preferred language per contact (MISSION.md RESPOND r10).
///
/// Keyed by phone rather than hung off a lead or waitlist row, for the same
/// reason `message_optout` is: somebody who replies in Spanish means it for
/// every message we ever send them, not just the one list they happen to be on.
model contact_language {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String   @unique @db.VarChar(20)
  /// en | es
  language   String   @default("en") @db.VarChar(5)
  /// reply | form | operator — how we learned it
  source     String?  @db.VarChar(16)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @default(now()) @db.Timestamptz(6)
}

/// A booked walk-through at a facility (MISSION.md RESPOND r6/r7).
///
/// `lead_status` already carried a 'toured' value and the schema anticipated
/// `tour_booked`, but nothing ever booked one. This is that missing table.
///
/// Reminders are found by sweeping this table rather than by enqueueing a job at
/// booking time with a future `run_after`: a rescheduled tour would leave the
/// pre-scheduled job pointing at the old time, and there is no flag column to
/// drift out of sync with what we actually sent — `message_log` is the record.
model facility_tours {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility_id   String    @db.Uuid
  /// The lead this tour belongs to, when it came from a form rather than a call.
  lead_id       String?   @db.Uuid
  contact_name  String?   @db.VarChar(120)
  contact_phone String    @db.VarChar(20)
  size_label    String?   @db.VarChar(32)
  /// Absolute time. The facility's zone is for rendering and the quiet-hours gate.
  scheduled_at  DateTime  @db.Timestamptz(6)
  /// booked | confirmed | completed | no_show | cancelled
  status        String    @default("booked") @db.VarChar(16)
  /// web | phone | sms | operator
  source        String?   @db.VarChar(16)
  cancelled_at  DateTime? @db.Timestamptz(6)
  completed_at  DateTime? @db.Timestamptz(6)
  no_show_at    DateTime? @db.Timestamptz(6)
  notes         String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @default(now()) @db.Timestamptz(6)

  facilities facilities     @relation(fields: [facility_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lead       partial_leads? @relation(fields: [lead_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// NOTE: a partial UNIQUE index `idx_tours_one_live` on
  /// (facility_id, contact_phone) WHERE status IN ('booked','confirmed') also
  /// exists in the database. Prisma cannot express an index predicate, so it
  /// lives only in `prisma/migrations/20260905_tours/migration.sql` — it is what
  /// makes a second booking a reschedule instead of a duplicate tour, and
  /// `bookTour` infers it as its ON CONFLICT target. Do not "clean up" the
  /// apparent absence of a unique constraint here.
  @@index([status, scheduled_at], map: "idx_tours_due")
  @@index([facility_id, scheduled_at(sort: Desc)], map: "idx_tours_facility")
  @@index([contact_phone], map: "idx_tours_phone")
  @@index([lead_id], map: "idx_tours_lead")
}

/// MISSION.md s12 — one browser, keyed by the first-party `sa_vid` cookie that
/// `/api/tracking/visit` sets from the server (so Safari's 7-day cap on
/// script-written storage does not apply). Becomes known when the same browser
/// submits a phone or email; several visitors (devices) can resolve to one lead.
model visitors {
  /// The cookie value. Matches `partial_leads.visitor_id`.
  id              String    @id @db.VarChar(64)
  partial_lead_id String?   @db.Uuid
  first_seen_at   DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at    DateTime  @default(now()) @db.Timestamptz(6)
  identified_at   DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  lead    partial_leads? @relation(fields: [partial_lead_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  touches touches[]

  @@index([partial_lead_id], map: "idx_visitors_lead")
}

/// MISSION.md s12 — one arrival that carries a source, or one inbound call.
/// Append-only: first and latest touch are queries over these rows
/// (`src/lib/attribution/touch.ts`), never fields that get overwritten.
/// A bare direct revisit writes no row — it cannot change any attribution model.
model touches {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitor_id      String?  @db.VarChar(64)
  /// Set for call touches at write time and for web touches once the visitor is identified.
  partial_lead_id String?  @db.Uuid
  facility_id     String?  @db.Uuid
  landing_page_id String?  @db.Uuid
  /// visit | call
  kind            String   @db.VarChar(16)
  /// paid_search | paid_social | paid_other | organic_search | organic_social | email | referral | direct | call
  channel         String   @db.VarChar(32)
  /// google | meta | tiktok | microsoft | the utm_source | the referring host
  source          String?  @db.VarChar(64)
  /// External identity (a Twilio CallSid); unique per kind so a redelivered webhook records once.
  source_ref      String?  @db.VarChar(128)
  occurred_at     DateTime @default(now()) @db.Timestamptz(6)
  url             String?  @db.VarChar(2000)
  referrer        String?  @db.VarChar(2000)
  utm_source      String?  @db.VarChar(200)
  utm_medium      String?  @db.VarChar(200)
  utm_campaign    String?  @db.VarChar(200)
  utm_content     String?  @db.VarChar(200)
  utm_term        String?  @db.VarChar(200)
  gclid           String?  @db.VarChar(512)
  gbraid          String?  @db.VarChar(512)
  wbraid          String?  @db.VarChar(512)
  fbclid          String?  @db.VarChar(512)
  fbc             String?  @db.VarChar(512)
  fbp             String?  @db.VarChar(128)
  ttclid          String?  @db.VarChar(512)
  msclkid         String?  @db.VarChar(512)
  /// sha256 of the caller's last ten digits (call touches only).
  phone_hash      String?  @db.VarChar(64)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  visitor    visitors?      @relation(fields: [visitor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lead       partial_leads? @relation(fields: [partial_lead_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  facilities facilities?    @relation(fields: [facility_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([kind, source_ref], map: "touches_kind_source_ref")
  @@index([visitor_id, occurred_at], map: "idx_touches_visitor")
  @@index([partial_lead_id, occurred_at], map: "idx_touches_lead")
  @@index([facility_id, occurred_at(sort: Desc)], map: "idx_touches_facility")
  @@index([facility_id, phone_hash], map: "idx_touches_phone")
}

/// MISSION.md s12 — every move-in we tried to report to an ad platform, and
/// what happened. The audit trail behind cost per move-in, and the source for
/// "failed conversion reporting" in the operator queue.
model conversion_reports {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility_id     String?   @db.Uuid
  partial_lead_id String?   @db.Uuid
  tenant_id       String?   @db.Uuid
  /// meta | google
  platform        String    @db.VarChar(16)
  /// Meta event_id / Google order_id — identical on every retry, so nothing double-counts.
  event_id        String    @db.VarChar(128)
  /// sent | skipped | failed
  status          String    @db.VarChar(16)
  reason          String?   @db.VarChar(64)
  detail          String?
  /// gclid | gbraid | wbraid | fbc | none
  click_id_type   String?   @db.VarChar(16)
  value           Decimal?  @db.Decimal(10, 2)
  currency        String    @default("USD") @db.VarChar(3)
  conversion_at   DateTime? @db.Timestamptz(6)
  sent_at         DateTime? @db.Timestamptz(6)
  attempts        Int       @default(0)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  lead       partial_leads? @relation(fields: [partial_lead_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  facilities facilities?    @relation(fields: [facility_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([platform, event_id], map: "conversion_reports_platform_event_id")
  @@index([status, created_at(sort: Desc)], map: "idx_conversion_reports_status")
  @@index([facility_id, created_at(sort: Desc)], map: "idx_conversion_reports_facility")
  @@index([partial_lead_id], map: "idx_conversion_reports_lead")
}

/// Proven Ads library — a self-storage ad observed in the wild, tracked over
/// time so the days it has been running can be computed.
///
/// One row per (source, source_ad_id). Rows from automated adapters are
/// refreshed by the `proven-ads.refresh` job; rows from the manual/CSV path
/// are verified by a person ("still running" / "ended"). `started_at`,
/// `last_seen_at`, `ended_at` and `active` are the facts; days running and the
/// proven flag are derived from them at read time (`src/lib/proven-ads/
/// days-running.ts`) rather than stored, so they can never go stale.
///
/// Only text, metadata and *references* to creative (snapshot URLs) are stored.
/// Images and video are never copied — the duplicate flow regenerates creative.
model proven_ads {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// meta_ad_library_api | manual | csv_import (adapter id)
  source              String    @db.VarChar(32)
  /// External identity (Meta Ad Library id). Manual rows get a generated one.
  source_ad_id        String    @db.VarChar(128)
  /// meta | google | tiktok
  platform            String    @db.VarChar(16)
  /// facebook | instagram | messenger | audience_network | search | youtube …
  publisher_platforms String[]  @default([])
  advertiser_name     String    @db.VarChar(200)
  advertiser_page_id  String?   @db.VarChar(64)
  advertiser_url      String?   @db.VarChar(2000)
  /// image | video | carousel | text | unknown
  format              String    @default("unknown") @db.VarChar(16)
  headline            String?   @db.VarChar(500)
  primary_text        String?
  description         String?   @db.VarChar(1000)
  cta                 String?   @db.VarChar(64)
  landing_url         String?   @db.VarChar(2000)
  /// Where the ad can be viewed at the source (Ad Library render URL). A
  /// reference, not a copy.
  snapshot_url        String?   @db.VarChar(2000)
  /// [{ kind: image|video, url }] — source-hosted references only.
  media_refs          Json?
  country             String?   @db.VarChar(2)
  /// US state / region code where known (manual rows); Meta API rows carry the
  /// reached country only.
  state               String?   @db.VarChar(8)
  city                String?   @db.VarChar(120)
  /// first_month_free | dollar_move_in | percent_off | free_truck | no_offer | other
  offer_type          String?   @db.VarChar(32)
  /// climate_controlled | drive_up | vehicle | business | general
  unit_type           String?   @db.VarChar(32)
  /// social_proof | convenience | urgency | lifestyle | price | other
  angle               String?   @db.VarChar(32)
  /// When the advertiser started delivery (Meta `ad_delivery_start_time`, or
  /// the "Started running on" date an admin reads off the Ad Library page).
  started_at          DateTime  @db.Date
  first_seen_at       DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at        DateTime  @default(now()) @db.Timestamptz(6)
  ended_at            DateTime? @db.Timestamptz(6)
  active              Boolean   @default(true)
  /// Full adapter payload, kept for re-classification without a refetch.
  raw                 Json?
  notes               String?
  /// 'system' for adapter rows, otherwise the admin who entered it.
  created_by          String?   @db.VarChar(120)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  ad_variations ad_variations[]

  @@unique([source, source_ad_id], map: "proven_ads_source_ad")
  @@index([platform, active], map: "idx_proven_ads_platform_active")
  @@index([started_at], map: "idx_proven_ads_started")
  @@index([state], map: "idx_proven_ads_state")
  @@index([offer_type], map: "idx_proven_ads_offer")
  @@index([last_seen_at], map: "idx_proven_ads_last_seen")
}

/// A configured discovery search for one adapter — e.g. "self storage" in
/// GB/IE on the Meta Ad Library API. Data, not code, so a new market or
/// keyword is an admin action rather than a deploy. The refresh job iterates
/// the enabled rows.
model proven_ad_searches {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adapter      String    @db.VarChar(32)
  label        String    @db.VarChar(120)
  /// Adapter-specific: { searchTerms, countries, pageIds, platforms }
  config       Json      @default("{}")
  enabled      Boolean   @default(true)
  last_run_at  DateTime? @db.Timestamptz(6)
  /// { fetched, upserted, pages, error } from the last run
  last_result  Json?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([adapter, enabled], map: "idx_proven_ad_searches_adapter")
}

// ── Restored drift (2026-10-05) ────────────────────────────────────────────
// Three tables the code has written to and read from since June, which were
// never in this schema and never existed in production — every write failed.
// Created by prisma/migrations/20261005_restore_drifted_tables. All three are
// used only through raw SQL; the models are here so the schema stops lying and
// a future `migrate dev` does not try to drop them.

/// Campaign alerts raised by /api/cron/check-campaign-alerts, shown on the
/// client portal home (/api/alert-history). One alert per client per type per
/// 24 hours — the cron checks before it inserts.
model alert_history {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id       String    @db.Uuid
  facility_id     String?   @db.Uuid
  /// no_campaigns | cpl_spike | roas_drop | lead_drought | movein_drop | milestone_roas
  alert_type      String    @db.VarChar(64)
  /// critical | warning | info
  severity        String    @db.VarChar(16)
  title           String
  detail          String?
  metric          Float?
  threshold       Float?
  acknowledged    Boolean   @default(false)
  acknowledged_by String?
  acknowledged_at DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([client_id, alert_type, created_at(sort: Desc)], map: "idx_alert_history_client_type")
  @@index([client_id, acknowledged], map: "idx_alert_history_client_ack")
}

/// Raw landing-page interaction events (/lp/[slug] → /api/page-interactions).
/// Append-only and pruned at 30 days by /api/cron/aggregate-page-stats, which
/// rolls each day up into page_interaction_stats first. No foreign keys on
/// purpose: an analytics beacon must not fail because a page was deleted.
model page_interactions {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landing_page_id String   @db.Uuid
  facility_id     String?  @db.Uuid
  session_id      String
  /// click | scroll | section_view | form_focus | cta_hover | page_load
  event_type      String   @db.VarChar(32)
  element_id      String?
  element_text    String?
  section_index   Int?
  x_pct           Float?
  y_pct           Float?
  scroll_depth    Int?
  viewport_width  Int?
  viewport_height Int?
  /// Seconds.
  time_on_page    Int      @default(0)
  utm_source      String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([landing_page_id, created_at], map: "idx_page_interactions_page_time")
  @@index([created_at], map: "idx_page_interactions_created")
}

/// Daily per-page rollup of page_interactions (heatmap, scroll, CTA clicks).
model page_interaction_stats {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landing_page_id  String   @db.Uuid
  period_date      DateTime @db.Date
  total_sessions   Int      @default(0)
  avg_scroll_depth Float    @default(0)
  avg_time_on_page Float    @default(0)
  click_zones      Json?
  section_views    Json?
  cta_clicks       Json?
  bounce_rate      Float    @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([landing_page_id, period_date], map: "page_interaction_stats_page_date_key")
}
